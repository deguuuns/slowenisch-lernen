# Optional: HTTP-Endpunkt für einen externen LLM-Tutor.
# Erwartet POST JSON: { system, message, history }
# und eine JSON-Antwort mit reply, output oder message.
AI_TUTOR_ENDPOINT=
AI_TUTOR_KEY=

# Server-only key for the iPhone/iPad speech-to-text fallback.
# Never expose this as NEXT_PUBLIC_*.
OPENAI_API_KEY=
