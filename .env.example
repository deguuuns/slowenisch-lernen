# Supabase: public browser configuration only. Never place service-role/secret keys here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional: HTTP-Endpunkt für einen externen LLM-Tutor.
# Erwartet POST JSON: { system, message, history }
# und eine JSON-Antwort mit reply, output oder message.
AI_TUTOR_ENDPOINT=
AI_TUTOR_KEY=
