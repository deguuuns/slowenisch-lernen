{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "es2019",
    "module": "commonjs",
    "moduleResolution": "node",
    "noEmit": false,
    "outDir": ".test-build",
    "incremental": false,
    "isolatedModules": false,
    "jsx": "react-jsx"
  },
  "include": [
    "tests/**/*.ts",
    "lib/answerMatching.ts",
    "lib/learningEngine.ts",
    "lib/slovenianTts.ts",
    "lib/cloudSync.ts",
    "lib/supabaseHttp.ts",
    "lib/storage.ts",
    "lib/profileStorage.ts",
    "lib/spacedRepetition.ts",
    "types/index.ts"
  ],
  "exclude": ["node_modules", ".next"]
}
